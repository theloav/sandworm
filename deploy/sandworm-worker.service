[Unit]
Description=Sandworm analysis worker
After=network.target

[Service]
User=sandworm
Group=sandworm
WorkingDirectory=/var/lib/sandworm
EnvironmentFile=/etc/sandworm/environment
ExecStart=/opt/sandworm/.venv/bin/sandworm worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sandworm
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
