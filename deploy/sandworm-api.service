[Unit]
Description=Sandworm API
After=network.target

[Service]
User=sandworm
Group=sandworm
WorkingDirectory=/var/lib/sandworm
EnvironmentFile=/etc/sandworm/environment
ExecStart=/opt/sandworm/.venv/bin/sandworm serve --host 127.0.0.1 --port 8000
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sandworm

[Install]
WantedBy=multi-user.target
