include LICENSE .env.example Dockerfile .dockerignore
recursive-include benchmarks *.json *.md *.svg *.php *.js *.sh *.ps1 *.yar
recursive-include docs *.md
recursive-include assets *.png
recursive-include samples/synthetic *
recursive-include samples/benign *
recursive-include plugins_example *.py
recursive-include tests *.py
recursive-include tests/fixtures *.json *.go
recursive-include deploy *.sh *.service *.yml Caddyfile
recursive-include sandworm/platform/static *.html *.css *.js
recursive-include sandworm/analyzers/static/scripts *.java
recursive-exclude * __pycache__ *.pyc *:Zone.Identifier
