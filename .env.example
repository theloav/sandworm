# SANDWORM configuration — copy to .env and adjust. Defaults are static-only.

# --- Work dir (runs, samples, audit log) ---
SANDWORM_WORK_DIR=.sandworm

# --- Operational workspace and trusted sandbox profiles ---
# SANDWORM_PROFILES=/etc/sandworm/profiles.json
# Remote worker only; issue a key for an account with role=worker.
# SANDWORM_WORKER_KEY=
# Optional separately installed decompiler:
# GHIDRA_HOME=/opt/ghidra

# --- CAPE backend (optional; unset means no live execution) ---
# SANDWORM_CAPE_URL=https://cape.internal/apiv2/
# SANDWORM_CAPE_TOKEN=
# SANDWORM_CAPE_IMAGE_ID=win11-clean@sha256:...
# Set only after validating the external deployment against the threat model.
SANDWORM_CAPE_ISOLATION_VERIFIED=false
# Plain HTTP requires an explicit opt-in (not recommended).
SANDWORM_CAPE_ALLOW_HTTP=false
# SANDWORM_CAPE_SIMULATED_ROUTE=inetsim

# --- Encrypted-at-rest sample store ---
SANDWORM_SAMPLE_PASSWORD=infected

# --- Graph backend (optional; in-memory fallback if unset) ---
# SANDWORM_NEO4J_URI=bolt://localhost:7687
# SANDWORM_NEO4J_USER=neo4j
# SANDWORM_NEO4J_PASSWORD=changeme

# --- LLM copilot (default: offline mock, no secret needed) ---
SANDWORM_LLM_PROVIDER=mock
SANDWORM_LLM_MODEL=claude-opus-4-8
# SANDWORM_LLM_API_KEY=
